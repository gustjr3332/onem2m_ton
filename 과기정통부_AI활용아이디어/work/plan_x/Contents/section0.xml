"1729" baseline="1288" spacing="0" horzpos="0" horzsize="48528" flags="393216"/><hp:lineseg textpos="58" vertpos="64991" vertsize="1729" textheight="1729" baseline="1288" spacing="0" horzpos="0" horzsize="48528" flags="393216"/></hp:linesegarray></hp:p><hp:p id="0" paraPrIDRef="9" styleIDRef="0" pageBreak="0" columnBreak="0" merged="0"><hp:run charPrIDRef="18"><hp:t>[여기에 작성: 개인정보·저작권 관련 위험 요소와 대응 방안을 작성합니다.]</hp:t></hp:run><hp:linesegarray><hp:lineseg textpos="0" vertpos="67720" vertsize="1815" textheight="1815" baseline="1352" spacing="272" horzpos="0" horzsize="48528" flags="393216"/></hp:linesegarray></hp:p><hp:p id="0" paraPrIDRef="7" styleIDRef="5" pageBreak="0" columnBreak="0" merged="0"><hp:run charPrIDRef="16"><hp:t>6. 맺음말</hp:t></hp:run><hp:linesegarray><hp:lineseg textpos="0" vertpos="71907" vertsize="2249" textheight="2249" baseline="1675" spacing="0" horzpos="0" horzsize="48528" flags="393216"/></hp:linesegarray></hp:p><hp:p id="0" paraPrIDRef="8" styleIDRef="0" pageBreak="0" columnBreak="0" merged="0"><hp:run charPrIDRef="17"><hp:t>▸ 아이디어를 한 문장으로 요약하고, 향후 구체화 방향(있다면)을 간단히 덧붙이세요. [심사기준: 전달력 및 완성도 10점]</hp:t></hp:run><hp:linesegarray><hp:lineseg textpos="0" vertpos="0" vertsize="1729" textheight="1729" baseline="1288" spacing="0" horzpos="0" horzsize="48528" flags="393216"/><hp:lineseg textpos="59" vertpos="1729" vertsize="1729" textheight="1729" baseline="1288" spacing="0" horzpos="0" horzsize="48528" flags="393216"/></hp:linesegarray></hp:p><hp:p id="0" paraPrIDRef="9" styleIDRef="0" pageBreak="0" columnBreak="0" merged="0"><hp:run charPrIDRef="18"><hp:t>[여기에 작성: 마무리 요약을 작성합니다.]</hp:t></hp:run><hp:linesegarray><hp:lineseg textpos="0" vertpos="4458" vertsize="1815" textheight="1815" baseline="1352" spacing="272" horzpos="0" horzsize="48528" flags="393216"/></hp:linesegarray></hp:p><hp:p id="0" paraPrIDRef="6" styleIDRef="0" pageBreak="1" columnBreak="0" merged="0"><hp:run charPrIDRef="14"><hp:t>Ⅱ. 샘플 (작성 예시)</hp:t></hp:run><hp:run charPrIDRef="15"><hp:t>   아래는 이해를 돕기 위한 가상의 예시입니다</hp:t></hp:run><hp:linesegarray><hp:lineseg textpos="0" vertpos="28" vertsize="2594" textheight="2594" baseline="1932" spacing="0" horzpos="0" horzsize="48528" flags="393216"/></hp:linesegarray></hp:p><hp:p id="0" paraPrIDRef="8" styleIDRef="0" pageBreak="0" columnBreak="0" merged="0"><hp:run charPrIDRef="19"><hp:t>※ 본 샘플은 형식 이해를 돕기 위해 작성된 가상의 사례이며, 실제 수치·서비스명은 예시일 뿐 사실이 아닙니다. 실제 제출 시 본인(팀)의 순수 창작물로 작성해야 합니다.</hp:t></hp:run><hp:linesegarray><hp:lineseg textpos="0" vertpos="3950" vertsize="1556" textheight="1556" baseline="1159" spacing="0" horzpos="0" horzsize="48528" flags="393216"/><hp:lineseg textpos="64" vertpos="5506" vertsize="1556" textheight="1556" baseline="1159" spacing="0" horzpos="0" horzsize="48528" flags="393216"/></hp:linesegarray></hp:p><hp:p id="0" paraPrIDRef="10" styleIDRef="0" pageBreak="0" columnBreak="0" merged="0"><hp:run charPrIDRef="20"><hp:t>말동무 AI — 1인 가구 안심 돌봄 알리미 서비스</hp:t></hp:run><hp:linesegarray><hp:lineseg textpos="0" vertpos="8062" vertsize="2421" textheight="2421" baseline="1803" spacing="0" horzpos="0" horzsize="48528" flags="393216"/></hp:linesegarray></hp:p><hp:p id="0" paraPrIDRef="10" styleIDRef="0" pageBreak="0" columnBreak="0" merged="0"><hp:run charPrIDRef="21"><hp:t>참가 구분: 개인 · 대표자: 홍길동(예시)</hp:t></hp:run><hp:linesegarray><hp:lineseg textpos="0" vertpos="11483" vertsize="1556" textheight="1556" baseline="1159" spacing="0" horzpos="0" horzsize="48528" flags="393216"/></hp:linesegarray></hp:p><hp:p id="0" paraPrIDRef="7" styleIDRef="5" pageBreak="0" columnBreak="0" merged="0"><hp:run charPrIDRef="16"><hp:t>1. 아이디어 개요</hp:t></hp:run><hp:linesegarray><hp:lineseg textpos="0" vertpos="15339" vertsize="2249" textheight="2249" baseline="1675" spacing="0" horzpos="0" horzsize="48528" flags="393216"/></hp:linesegarray></hp:p><hp:p id="0" paraPrIDRef="9" styleIDRef="0" pageBreak="0" columnBreak="0" merged="0"><hp:run charPrIDRef="0"><hp:t>최근 1인 가구와 독거 어르신이 빠르게 늘면서, 위급 상황이 발생해도 이를 즉시 알아채고 대응할 사람이 없는 경우가 많다. 기존의 응급벨·안심폰은 사용자가 직접 버튼을 눌러야만 작동해, 정작 의식을 잃거나 거동이 어려운 상황에서는 무용지물이 되기 쉽다. '말동무 AI'는 스마트 스피커 기반의 대화형 AI가 하루 한두 차례 사용자에게 먼저 말을 걸어 안부를 확인하고, 평소와 다른 반응이 감지되면 자동으로 보호자·지자체 복지센터에 알리는 일상 밀착형 돌봄 서비스다.</hp:t></hp:run><hp:linesegarray><hp:lineseg textpos="0" vertpos="18188" vertsize="1815" textheight="1815" baseline="1352" spacing="272" horzpos="0" horzsize="48528" flags="393216"/><hp:lineseg textpos="54" vertpos="20275" vertsize="1815" textheight="1815" baseline="1352" spacing="272" horzpos="0" horzsize="48528" flags="393216"/><hp:lineseg textpos="108" vertpos="22362" vertsize="1815" textheight="1815" baseline="1352" spacing="272" horzpos="0" horzsize="48528" flags="393216"/><hp:lineseg textpos="164" vertpos="24449" vertsize="1815" textheight="1815" baseline="1352" spacing="272" horzpos="0" horzsize="48528" flags="393216"/><hp:lineseg textpos="219" vertpos="26536" vertsize="1815" textheight="1815" baseline="1352" spacing="272" horzpos="0" horzsize="48528" flags="393216"/></hp:linesegarray></hp:p><hp:p id="0" paraPrIDRef="7" styleIDRef="5" pageBreak="0" columnBreak="0" merged="0"><hp:run charPrIDRef="16"><hp:t>2. 아이디어 상세 내용 및 차별성</hp:t></hp:run><hp:linesegarray><hp:lineseg textpos="0" vertpos="30723" vertsize="2249" textheight="2249" baseline="1675" spacing="0" horzpos="0" horzsize="48528" flags="393216"/></hp:linesegarray></hp:p><hp:p id="0" paraPrIDRef="9" styleIDRef="0" pageBreak="0" columnBreak="0" merged="0"><hp:run charPrIDRef="0"><hp:t>① 매일 정해진 시간, AI가 먼저 '오늘 컨디션 어떠세요?', '약은 챙겨 드셨어요?' 등 자연스러운 대화를 시도한다. ② 답변의 유무·목소리 톤·응답 지연을 분석해 평소와 다른 이상 신호를 감지한다. ③ 이상 신호가 2회 이상 반복되면 사전에 등록한 보호자에게 문자로 알리고, 무응답이 이어지면 지자체 복지 핫라인에 자동 연계한다. ④ 기존 응급벨이 '사용자가 눌러야 작동'하는 수동형인 것과 달리, 본 서비스는 AI가 먼저 다가가는 능동형 대화 방식이라는 점에서 차별화된다.</hp:t></hp:run><hp:linesegarray><hp:lineseg textpos="0" vertpos="33572" vertsize="1815" textheight="1815" baseline="1352" spacing="272" horzpos="0" horzsize="48528" flags="393216"/><hp:lineseg textpos="60" vertpos="35659" vertsize="1815" textheight="1815" baseline="1352" spacing="272" horzpos="0" horzsize="48528" flags="393216"/><hp:lineseg textpos="116" vertpos="37746" vertsize="1815" textheight="1815" baseline="1352" spacing="272" horzpos="0" horzsize="48528" flags="393216"/><hp:lineseg textpos="169" vertpos="39833" vertsize="1815" textheight="1815" baseline="1352" spacing="272" horzpos="0" horzsize="48528" flags="393216"/><hp:lineseg textpos="226" vertpos="41920" vertsize="1815" textheight="1815" baseline="1352" spacing="272" horzpos="0" horzsize="48528" flags="393216"/></hp:linesegarray></hp:p><hp:p id="0" paraPrIDRef="7" styleIDRef="5" pageBreak="0" columnBreak="0" merged="0"><hp:run charPrIDRef="16"><hp:t>3. 실현 가능성</hp:t></hp:run><hp:linesegarray><hp:lineseg textpos="0" vertpos="46107" vertsize="2249" textheight="2249" baseline="1675" spacing="0" horzpos="0" horzsize="48528" flags="393216"/></hp:linesegarray></hp:p><hp:p id="0" paraPrIDRef="9" styleIDRef="0" pageBreak="0" columnBreak="0" merged="0"><hp:run charPrIDRef="0"><hp:t>시중 스마트 스피커(음성 인식 API)와 상용 대화형 AI 모델을 결합하고, 지자체가 이미 운영 중인 독거노인 안부확인 시스템의 API에 연동하는 방식으로 구현 가능하다. 신규 하드웨어 개발 없이 기존 스피커에 소프트웨어를 얹는 구조이므로 초기 투자 비용이 낮고, 지자체 복지예산 내 기존 안부확인 인력 업무를 보조·경감하는 효과가 있어 비용 대비 효과가 크다고 판단된다.</hp:t></hp:run><hp:linesegarray><hp:lineseg textpos="0" vertpos="48956" vertsize="1815" textheight="1815" baseline="1352" spacing="272" horzpos="0" horzsize="48528" flags="393216"/><hp:lineseg textpos="58" vertpos="51043" vertsize="1815" textheight="1815" baseline="1352" spacing="272" horzpos="0" horzsize="48528" flags="393216"/><hp:lineseg textpos="113" vertpos="53130" vertsize="1815" textheight="1815" baseline="1352" spacing="272" horzpos="0" horzsize="48528" flags="393216"/><hp:lineseg textpos="167" vertpos="55217" vertsize="1815" textheight="1815" baseline="1352" spacing="272" horzpos="0" horzsize="48528" flags="393216"/></hp:linesegarray></hp:p><hp:p id="0" paraPrIDRef="7" styleIDRef="5" pageBreak="0" columnBreak="0" merged="0"><hp:run charPrIDRef="16"><hp:t>4. 기대 효과 및 파급력</hp:t></hp:run><hp:linesegarray><hp:lineseg textpos="0" vertpos="59404" vertsize="2249" textheight="2249" baseline="1675" spacing="0" horzpos="0" horzsize="48528" flags="393216"/></hp:linesegarray></hp:p><hp:p id="0" paraPrIDRef="9" styleIDRef="0" pageBreak="0" columnBreak="0" merged="0"><hp:run charPrIDRef="0"><hp:t>독거 어르신·1인 가구의 고립사·응급상황 대응 공백을 줄이고, 보호자에게는 '매일 확인해야 한다'는 심리적 부담을 덜어준다. 초기에는 노년층을 대상으로 하되, 이후에는 자취 대학생, 야간 근무자 등 응급 상황에 취약한 모든 1인 가구로 확장할 수 있어 사회 안전망 전반으로 파급될 잠재력이 있다.</hp:t></hp:run><hp:linesegarray><hp:lineseg textpos="0" vertpos="62253" vertsize="1815" textheight="1815" baseline="1352" spacing="272" horzpos="0" horzsize="48528" flags="393216"/><hp:lineseg textpos="56" vertpos="64340" vertsize="1815" textheight="1815" baseline="1352" spacing="272" horzpos="0" horzsize="48528" flags="393216"/><hp:lineseg textpos="111" vertpos="66427" vertsize="1815" textheight="1815" baseline="1352" spacing="272" horzpos="0" horzsize="48528" flags="393216"/></hp:linesegarray></hp:p><hp:p id="0" paraPrIDRef="7" styleIDRef="5" pageBreak="0" columnBreak="0" merged="0"><hp:run charPrIDRef="16"><hp:t>5. AI 윤리 및 안전성 고려사항</hp:t></hp:run><hp:linesegarray><hp:lineseg textpos="0" vertpos="70614" vertsize="2249" textheight="2249" baseline="1675" spacing="0" horzpos="0" horzsize="48528" flags="393216"/></hp:linesegarray></hp:p><hp:p id="0" paraPrIDRef="9" styleIDRef="0" pageBreak="0" columnBreak="0" merged="0"><hp:run charPrIDRef="0"><hp:t>대화 내용에는 건강·생활 습관 등 민감한 개인정보가 포함될 수 있으므로, 음성 데이터는 로컬 기기에서 1차 처리 후 최소한의 정보만 암호화하여 서버로 전송하고 일정 기간 후 자동 파기하는 것을 원칙으로 한다. 보호자·복지기관 연계 시에도 사전 동의 절차를 명확히 거치도록 설계한다.</hp:t></hp:run><hp:linesegarray><hp:lineseg textpos="0" vertpos="0" vertsize="1815" textheight="1815" baseline="1352" spacing="272" horzpos="0" horzsize="48528" flags="393216"/><hp:lineseg textpos="54" vertpos="2087" vertsize="1815" textheight="1815" baseline="1352" spacing="272" horzpos="0" horzsize="48528" flags="393216"/><hp:lineseg textpos="108" vertpos="4174" vertsize="1815" textheight="1815" baseline="1352" spacing="272" horzpos="0" horzsize="48528" flags="393216"/></hp:linesegarray></hp:p><hp:p id="0" paraPrIDRef="7" styleIDRef="5" pageBreak="0" columnBreak="0" merged="0"><hp:run charPrIDRef="16"><hp:t>6. 맺음말</hp:t></hp:run><hp:linesegarray><hp:lineseg textpos="0" vertpos="8361" vertsize="2249" textheight="2249" baseline="1675" spacing="0" horzpos="0" horzsize="48528" flags="393216"/></hp:linesegarray></hp:p><hp:p id="0" paraPrIDRef="9" styleIDRef="0" pageBreak="0" columnBreak="0" merged="0"><hp:run charPrIDRef="0"><hp:t>'말동무 AI'는 AI가 먼저 다가가 안부를 묻는 능동형 돌봄으로, 1인 가구의 안전 공백을 메우는 생활 밀착형 서비스다. 향후 지자체 시범사업과 연계해 실제 사용성을 검증해 나가고자 한다.</hp:t></hp:run><hp:linesegarray><hp:lineseg textpos="0" vertpos="11210" vertsize="1815" textheight="1815" baseline="1352" spacing="272" horzpos="0" horzsize="48528" flags="393216"/><hp:lineseg textpos="59" vertpos="13297" vertsize="1815" textheight="1815" baseline="1352" spacing="272" horzpos="0" horzsize="48528" flags="393216"/></hp:linesegarray></hp:p></hs:sec>